DATABASE_URL=mysql+pymysql://equal_care:local_dev_password@127.0.0.1:3306/equal_care?charset=utf8mb4
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional; defaults to ../data/processed relative to backend's source location.
# DATA_DIR=/absolute/path/to/data/processed
MARIADB_DATABASE=equal_care
MARIADB_USER=equal_care
MARIADB_PASSWORD=local_dev_password
MARIADB_ROOT_PASSWORD=local_root_password

# Backend only. Never use a VITE_ prefix for credentials.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-4-carbon
# To switch APIs: LLM_PROVIDER=openai-compatible and set these plus LLM_MODEL.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=120
